# Lobu adapter env — point STATE-Bench's eval + agent clients at the local LiteLLM
# proxy (which bridges Responses API -> Chat Completions to a non-OpenAI backend).
# The proxy must run with SERVER_ROOT_PATH=/openai so these endpoints resolve to
# /openai/v1/responses (STATE-Bench's azure provider appends /openai/v1/).

# Locked simulator + judge -> proxy. For COMPARABLE scores this must be real gpt-5.4
# (e.g. OpenRouter openai/gpt-5.4 behind the proxy). GLM here = internal signal only.
STATE_BENCH_EVAL_ENDPOINT="http://localhost:4000"
STATE_BENCH_EVAL_DEPLOYMENTS="gpt-5.4"
STATE_BENCH_EVAL_API_KEY="sk-statebench-local"   # the LiteLLM master key, not a secret

# Agent under test -> same proxy/model.
STATE_BENCH_AGENT_ENDPOINT="http://localhost:4000"
STATE_BENCH_AGENT_DEPLOYMENTS="gpt-5.4"
STATE_BENCH_AGENT_API_KEY="sk-statebench-local"

# Lobu memory (Agent Learning Track). Mint LOBU_PAT via POST /api/local-init.
LOBU_MCP_URL="http://127.0.0.1:8787/mcp"
# LOBU_PAT="owl_pat_..."
